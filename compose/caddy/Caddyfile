{$GRAFANA_DOMAIN} {
    reverse_proxy grafana:3000
}

http://minio.internal {
    # .internal은 HTTP 전용 — MinIO가 보내는 HSTS 헤더 제거 (브라우저 https 강제 치환 방지)
    reverse_proxy {$MAC_TAILNET_IP}:9000 {
        header_down -Strict-Transport-Security
    }
}

http://minio-console.internal {
    reverse_proxy {$MAC_TAILNET_IP}:9001 {
        header_down -Strict-Transport-Security
    }
}

http://prometheus.internal {
    reverse_proxy prometheus:9090
}

http://neo4j.internal {
    reverse_proxy neo4j:7474
}

http://adminer.internal {
    reverse_proxy adminer:8080
}

http://registry-ui.internal {
    reverse_proxy registry-ui:80
}

http://rondo-api.internal {
    reverse_proxy rondo-daemon:8000
}

http://rondo-dashboard.internal {
    reverse_proxy rondo-dashboard:8501
}

http://pot-of-greed-api.internal {
    reverse_proxy pot-of-greed-api:8000
}

http://pot-of-greed-ui.internal {
    reverse_proxy pot-of-greed-ui:8000
}

# 공개 도메인 노출 시: POT_OF_GREED_DOMAIN을 ops-vm.env에 설정하고 아래 블록 활성화
# {$POT_OF_GREED_DOMAIN} {
#     header { Strict-Transport-Security "max-age=31536000"; X-Frame-Options "SAMEORIGIN"; X-Content-Type-Options "nosniff" }
#     reverse_proxy pot-of-greed-ui:8000
# }

{$AIRFLOW_DOMAIN} {
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
    }

    # edge worker v1 API — Tailscale 직결 전용, 공인 노출 차단
    handle /edge_worker/v1/* {
        respond 404
    }

    handle {
        reverse_proxy api-server:8080
    }
}

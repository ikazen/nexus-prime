global:
  resolve_timeout: 5m

route:
  receiver: discord
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # mac 은 intermittent — sleep 시 NodeDown fire 가능하니 repeat 길게. 다른 노드는 기본(4h).
    - matchers:
        - job="node_mac_server"
      receiver: discord
      repeat_interval: 12h

receivers:
  - name: discord
    discord_configs:
      - webhook_url: <your-discord-webhook-url>
        title: '[{{ .Status | toUpper }}] {{ .CommonLabels.alertname }}'
        message: '{{ range .Alerts }}{{ .Annotations.summary }}{{ end }}'

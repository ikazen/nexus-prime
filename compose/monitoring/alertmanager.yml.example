global:
  resolve_timeout: 5m

route:
  receiver: discord
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - matchers:
        - job="node_mac_server"
      receiver: discord
      repeat_interval: 12h
    # mac edge worker 는 intermittent — sleep 시 fire 가능하니 길게. worker-vm/ops-vm 은 기본(4h).
    - matchers:
        - alertname="EdgeWorkerOffline"
        - worker_name="mac-server"
      receiver: discord
      repeat_interval: 12h

receivers:
  - name: discord
    discord_configs:
      - webhook_url: <your-discord-webhook-url>
        title: '[{{ .Status | toUpper }}] {{ .CommonLabels.alertname }}'
        message: '{{ range .Alerts }}{{ .Annotations.summary }}{{ end }}'

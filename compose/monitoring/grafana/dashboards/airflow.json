    {
      "id": 100,
      "type": "timeseries",
      "title": "DAG run 완료 rate — rondo",
      "datasource": {
        "type": "prometheus",
        "uid": "bfnc68nag9p8ga"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(airflow_dagrun_duration_success_count{dag_id=~\"reflexion_rondo.*\"}[1h]))",
          "legendFormat": "success"
        },
        {
          "refId": "B",
          "expr": "sum(increase(airflow_dagrun_duration_failed_count{dag_id=~\"reflexion_rondo.*\"}[1h]))",
          "legendFormat": "failure"

# worker-vm / mac-server 용 Promtail config.
# 복사 후 ${OPS_TAILNET_IP} 를 실제 값으로 채워 /etc/promtail/promtail.yml 에 저장.
# 실행 시 -config.expand-env=true 플래그로 $HOSTNAME 자동 치환.

server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /tmp/promtail-positions.yaml

clients:
  - url: http://${OPS_TAILNET_IP}:3100/loki/api/v1/push

scrape_configs:
  - job_name: docker
    static_configs:
      - targets: [localhost]
        labels:
          host: ${HOSTNAME}
          __path__: /var/lib/docker/containers/*/*-json.log
    pipeline_stages:
      - json:
          expressions:
            output: log
            stream: stream
      - labels:
          stream:
      - output:
          source: output

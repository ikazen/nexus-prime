# worker-vm: native binary, /var/run/docker.sock 직접 접근 (root 실행이라 권한 문제 없음)
# mac-server: Docker 컨테이너로 실행 — compose/_hosts/mac-server.yml 이 마운트·env 주입
# -config.expand-env=true 로 $HOSTNAME, $OPS_TAILNET_IP 치환

server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /tmp/promtail-positions.yaml

clients:
  - url: http://${OPS_TAILNET_IP}:3100/loki/api/v1/push

scrape_configs:
  - job_name: docker
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 5s
    relabel_configs:
      - source_labels: [__meta_docker_container_name]
        regex: '/(.*)'
        target_label: container_name
      - target_label: host
        replacement: ${HOSTNAME}
    pipeline_stages:
      - json:
          expressions:
            output: log
            stream: stream
      - labels:
          stream:
      - output:
          source: output

{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama-cloud": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Cloud",
      "options": {
        "baseURL": "https://ollama.com/v1",
        "apiKey": "{file:/root/.secrets/ollama_api_key}"
      },
      "models": {
        "glm-5.2:cloud": {
          "name": "GLM-5.2 (Ollama Cloud)"
        }
      }
    }
  }
}

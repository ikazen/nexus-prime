# worker-vm 인프라 컨테이너 통합 env. 단일 .env 가 wrapper 진입점.

# tailnet
OPS_TAILNET_IP=
WORKER_TAILNET_IP=

# omnigent — meta-harness 에이전트 서버 (control-plane, single-user 모드, L25).
# 위치·노출 격리는 docs/decisions.md L23 참조. DB 는 ops-vm Postgres 를 tailnet 으로 직결.
OMNIGENT_TAG=latest
OMNIGENT_PG_USER=omnigent
OMNIGENT_PG_PASSWORD=
OMNIGENT_PG_DB=omnigent

# omnigent-host — 실제 harness(claude-native/codex/opencode) 실행 러너 (L25).
# 이미지는 registry.internal:5000/omnigent-host — dev-guide "omnigent host 이미지 빌드" 참조.
OMNIGENT_HOST_TAG=latest
# Claude 구독 인증 (L26) — 로컬에서 `claude setup-token` 1회 실행해 만든 값.
CLAUDE_CODE_OAUTH_TOKEN=
# Codex 는 여기 없음 — 개인 ChatGPT Plus/Pro 플랜은 헤드리스 토큰이 없어 배포 후
# `docker exec -it omnigent-host codex login --device-auth` 로 직접 로그인 (dev-guide
# "omnigent 하니스 구독 인증" 참조). 지금은 보류 중.

# ollama 사이드카(L27) — OpenCode 의 Ollama Cloud provider 가 이 컨테이너를 통해 나간다.
# omnigent-host 가 아니라 ollama 서비스의 env. https://ollama.com/settings/keys 에서 발급.
OLLAMA_API_KEY=
# git-worker 에이전트 — fine-grained PAT (대상 repo 만 Contents=RW, Pull requests=RW, Metadata=RO)
OMNIGENT_GH_TOKEN=
# git-worker 에이전트 — omnigent_ro role DSN (dev-guide "Postgres read-only role 발급")
OMNIGENT_RONDO_RO_URL=
OMNIGENT_POG_RO_URL=
# 인터랙티브 세션(사용자가 직접 만드는 세션)용 GitHub fine-grained PAT — OMNIGENT_GH_TOKEN
# 과 별개 토큰. 발급 절차는 dev-guide "인터랙티브 세션 GitHub 인증"
OMNIGENT_INTERACTIVE_GH_TOKEN=

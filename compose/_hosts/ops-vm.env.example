# ops-vm 인프라 컨테이너 통합 env (caddy / postgres / registry / monitoring).
# 각 기능 폴더의 .env.example 도 같은 변수를 보여주지만, 운영 정공법은 wrapper 단일 .env.

# caddy
AIRFLOW_DOMAIN=airflow.<your-domain>

# postgres — superuser 계정 (airflow 용 DB/user 는 runbook 절차로 별도 생성)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# registry
OPS_TAILNET_IP=

# monitoring (R4) — Grafana + Prometheus + node_exporter + statsd_exporter + cAdvisor
GRAFANA_DOMAIN=grafana.<your-domain>
GRAFANA_ADMIN_PASSWORD=
WORKER_TAILNET_IP=
MAC_TAILNET_IP=

# Alertmanager Discord webhook — alertmanager.yml 에도 동일 URL 입력 필요
# alertmanager.yml 은 gitignored: alertmanager.yml.example 복사 후 편집

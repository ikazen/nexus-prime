# ops-vm 인프라 컨테이너 통합 env. 단일 .env 가 wrapper 진입점.

# caddy
AIRFLOW_DOMAIN=airflow.<your-domain>
POT_OF_GREED_DOMAIN=tax.<your-domain>
OMNIGENT_DOMAIN=agent.<your-domain>

# postgres — superuser. 서비스별 DB/user 는 runbook 절차로 별도 생성.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# registry
OPS_TAILNET_IP=

# monitoring
GRAFANA_DOMAIN=grafana.<your-domain>
GRAFANA_ADMIN_PASSWORD=
WORKER_TAILNET_IP=
MAC_TAILNET_IP=

# neo4j — minimum 8 chars
NEO4J_PASSWORD=

# pot-of-greed — 세법 RAG 백엔드
POG_TAG=latest
POG_PG_USER=potofgreed
POG_PG_PASSWORD=
POG_PG_DB=potofgreed
POG_JWT_SECRET=
POG_AUTH_USERS=admin:<bcrypt-hash>
POG_CHAINLIT_AUTH_SECRET=
OLLAMA_BASE_URL=http://<MAC_TAILNET_IP>:11434
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_API_KEY=

# omnigent — meta-harness 에이전트 서버 (Claude Code + OpenCode 오케스트레이션)
OMNIGENT_TAG=latest
OMNIGENT_PG_USER=omnigent
OMNIGENT_PG_PASSWORD=
OMNIGENT_PG_DB=omnigent
OMNIGENT_ACCOUNTS_COOKIE_SECRET=
OMNIGENT_ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Alertmanager Discord webhook → alertmanager.yml.example 복사 후 webhook URL 채움 (gitignored)
